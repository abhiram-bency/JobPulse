# --- PostgreSQL ---
POSTGRES_USER=jobpulse
POSTGRES_PASSWORD=jobpulse
POSTGRES_DB=jobpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Backend will build DATABASE_URL from the above when DATABASE_URL is not set,
# or set DATABASE_URL explicitly to override:
# DATABASE_URL=postgresql+psycopg://jobpulse:jobpulse@localhost:55432/jobpulse

# --- Ingestion / source behaviour ---
# Himalayas RSS feed used as the low-risk demo source
HIMALAYAS_FEED_URL=https://himalayas.app/jobs/rss
HIMALAYAS_USER_AGENT=JobPulse/1.0 (job ingestion dashboard; contact: ops@example.com)

# Bounded retries with exponential backoff
FETCH_TIMEOUT_SECONDS=20.0
FETCH_MAX_RETRIES=3
FETCH_BASE_BACKOFF_SECONDS=1.0
FETCH_MAX_BACKOFF_SECONDS=30.0

# Responsible traffic: minimum delay between requests to the same source
MINIMUM_REQUEST_INTERVAL_SECONDS=5.0

# Suspicious-result detection
MIN_VALID_JOBS_THRESHOLD=1
MAX_INVALID_RATIO=0.5

# --- API ---
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# --- Alembic ---
ALEMBIC_DATABASE_URL=postgresql+psycopg://jobpulse:jobpulse@localhost:55432/jobpulse